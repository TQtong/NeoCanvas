# Supabase 公共连接信息。不要在此文件放 service_role 或模型提供商密钥。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 仅 Docker 连接 Supabase CLI 本地栈时填写；托管 Supabase 保持为空。
SUPABASE_INTERNAL_URL=

# 浏览器访问地址，必须同时加入 Supabase Auth 的 Site URL / Redirect URLs。
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# 精准编辑入口。该值在 Docker 构建期写入浏览器包。
NEXT_PUBLIC_IMAGE_EDITING_ENABLED=false

# Docker 主机映射端口。修改后也要同步修改 NEXT_PUBLIC_SITE_URL。
NEOCANVAS_PORT=3100
