# ============================================================================
# NeoCanvas 环境变量样例
#
# 复制为 .env.local 时，本地前端只需填写三个 NEXT_PUBLIC_* 变量。
# 下方标注「仅服务端 / Edge」的变量应通过 `supabase secrets set` 部署，绝不可暴露给浏览器；
# 不要在共享电脑或将要提交的 .env.local 中保留这些私钥。
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase —— 客户端可见（匿名公钥本身不授予任何数据权限，权限来自用户 JWT + RLS）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 仅 Docker 连接 Supabase CLI 本地栈时使用；托管 Supabase 保持为空
SUPABASE_INTERNAL_URL=

# ---------------------------------------------------------------------------
# Supabase —— 仅服务端 / Edge（绕过 RLS 的最高权限，绝不下发到客户端）
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# 站点地址（用于 OAuth 回调与分享链接拼装）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# 精准编辑入口。生产灰度完成前保持 false，本地开发可设为 true。
NEXT_PUBLIC_IMAGE_EDITING_ENABLED=false

# ---------------------------------------------------------------------------
# 外部模型 API 密钥 —— 仅 Edge Functions 可见
# ---------------------------------------------------------------------------
# OpenAI（GPT Image 2，图像）
OPENAI_API_KEY=sk-...
# Google Gemini / Nano Banana Pro（图像）
GOOGLE_API_KEY=...
# 火山方舟 Volcengine Ark（Seedance 2.0 视频 / Seedream 图像）
ARK_API_KEY=...
# fal.ai（聚合平台）
FAL_API_KEY=...
# Replicate（聚合平台）
REPLICATE_API_TOKEN=...
# SiliconFlow（图片 / 视频）
SILICONFLOW_API_KEY=...
# 仅使用兼容代理或自建网关时覆盖
SILICONFLOW_BASE_URL=
# MiniMax（Image 01 / Hailuo 视频）
MINIMAX_API_KEY=...
# 即梦使用 Access Key ID + Secret Access Key 双凭据，请在「设置 → 模型提供商」中配置

# 编排型 LLM（智能体编排模式所用语言模型；默认复用 OPENAI_API_KEY）
ORCHESTRATOR_LLM_API_KEY=
ORCHESTRATOR_LLM_MODEL=gpt-4o-mini
# 仅使用 OpenAI 兼容代理或自建网关时覆盖
ORCHESTRATOR_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# 生成流水线参数
# ---------------------------------------------------------------------------
# 单用户在途生成数上限（防刷量）
MAX_INFLIGHT_GENERATIONS=8
# running 任务超时（毫秒），超过即判定超时失败
GENERATION_TIMEOUT_MS=600000
# 提供商回调签名校验密钥
GENERATION_WEBHOOK_SECRET=change-me
