{
  "name": "neocanvas",
  "version": "0.1.0",
  "private": true,
  "description": "NeoCanvas — 对话驱动 + 无限画布的 AI 设计代理（AI Design Agent）",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "docker:up": "docker compose --env-file .env.docker up -d --build --remove-orphans",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f web",
    "contracts:generate": "node scripts/generate-edge-contracts.mjs",
    "contracts:check": "node scripts/generate-edge-contracts.mjs --check",
    "lint": "eslint . --ext .ts,.tsx,.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,mjs}\" && npm run contracts:generate && deno fmt --config supabase/functions/deno.json supabase/functions",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,mjs}\"",
    "functions:check": "deno fmt --config supabase/functions/deno.json --check supabase/functions && deno lint --config supabase/functions/deno.json supabase/functions && deno check --no-lock --config supabase/functions/deno.json \"supabase/functions/*/index.ts\" && npm run test:edge",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:edge": "deno test --no-lock --config supabase/functions/deno.json --allow-env supabase/functions",
    "test:db": "supabase test db",
    "test:integration": "node scripts/run-supabase-integration-tests.mjs",
    "test:e2e": "playwright test",
    "db:lint": "supabase db lint --local --level warning",
    "check": "npm run contracts:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run functions:check && npm run db:lint && npm run test:db && npm run test:integration && npm run build && npm run test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "functions:serve": "supabase functions serve --no-verify-jwt --env-file supabase/functions/.env"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@xyflow/react": "^12.3.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "deno": "^2.9.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "postcss": "8.5.26",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "supabase": "^2.107.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
